# ─────────────────────────────────────────────
# ArcSwap — Environment Variables
# Copy this file to .env.local and fill in the values marked TODO.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Arc Testnet (hardcoded in source — no need to change) ────
# Chain ID:   5042002
# RPC:        https://rpc.testnet.arc.network
# Explorer:   https://explorer.testnet.arc.network
# USDC:       0x3600000000000000000000000000000000000000 (native precompile)

# ── WalletConnect ─────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=    # TODO

# ── Token Addresses ──────────────────────────
# USDC is hardcoded (Arc native precompile) — no env var needed.
NEXT_PUBLIC_EURC_ADDRESS=                # TODO
NEXT_PUBLIC_CIRBTC_ADDRESS=              # TODO — Arc Testnet circle BTC token address

# VIBE: deployed by this project
# Run: cd contracts && pnpm deploy:testnet
NEXT_PUBLIC_VIBE_TOKEN_ADDRESS=          # TODO (deploy first)

# ── DEX Router ───────────────────────────────
NEXT_PUBLIC_SWAP_ROUTER_ADDRESS=         # TODO

# ── Contract Deployment (server-side only) ───
PRIVATE_KEY=                             # TODO (deployer wallet private key)